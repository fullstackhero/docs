---
import { Icon } from 'astro-icon/components';

// Trust-strip views readout for the landing page. Reuses the shared
// /api/views beacon (src/scripts/views-counter.ts) — same data plumbing as
// the docs PageHeader chip, but rendered as plain strip items rather than a
// bordered pill so it matches the neighbouring trust-strip entries.
//
// Renders its own leading "·" separator so the two reveal/hide together: a
// slow or failed beacon shows neither (no dangling separator).
//
// Dev: render in `ready` with a sample value so the items are visible under
// `astro dev` (the Worker isn't running, so the beacon 404s). Prod: render in
// `pending`; the client beacon flips them to `ready` only on a successful
// response, so it never flashes "0 views".
const isDev = import.meta.env.DEV;
const initialState = isDev ? 'ready' : 'pending';
const initialCount = isDev ? '1,234' : '0';
---

<li aria-hidden="true" data-views-sep data-state={initialState} class="views-reveal text-muted-foreground/40">·</li>
<li
  data-views-count-wrap
  data-state={initialState}
  title={isDev ? 'Sample value — run wrangler dev to see real counts' : undefined}
  class="views-reveal inline-flex items-center gap-1.5"
>
  <Icon name="lucide:eye" class="h-3 w-3" aria-hidden="true" />
  <span class="views-num font-medium tabular-nums text-foreground" data-views-count>{initialCount}</span>
  <span>views</span>
</li>

<style>
  /* The count loads async (a deferred /api/views beacon), so the separator
     and the readout both stay hidden until it resolves, then reveal together.
     `visibility: hidden` (not display:none) keeps their layout slot reserved,
     so revealing never reflows the centred strip. The translate/opacity reveal
     is transform-based — it doesn't trigger layout, so it costs zero CLS. */
  .views-reveal {
    transition:
      opacity 360ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 360ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .views-reveal[data-state='pending'] {
    opacity: 0;
    visibility: hidden;
    transform: translateY(2px);
  }
  .views-reveal[data-state='ready'] {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* Fixed numeric box: the count-up grows in place (right-aligned, odometer
     style) instead of widening the <li> and re-centring the whole strip.
     This is what keeps CLS at zero. tabular-nums makes every digit the same
     width; 5ch comfortably holds a 4-digit comma'd count (e.g. "1,234"). */
  .views-num {
    display: inline-block;
    min-width: 5ch;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .views-reveal {
      transition: none;
    }
  }
</style>

<script>
  import '../../scripts/views-counter';
</script>
