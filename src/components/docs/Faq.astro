---
/**
 * Faq — a docs-page FAQ block that doubles as GEO/AI-citation surface.
 *
 * Renders an accessible <details> disclosure list AND emits FAQPage JSON-LD
 * so AI engines (ChatGPT, Claude, Perplexity, Gemini, Google AI Overviews)
 * can extract the Q&A pairs directly. Mirrors the landing-page FAQ pattern
 * (src/components/landing/FAQ.astro) but scoped for in-article use via MDX.
 *
 * Usage in MDX:
 *   <Faq items={[
 *     { q: "Is fullstackhero free?", a: "Yes — MIT licensed end to end." },
 *   ]} />
 *
 * Answers are plain strings (no markup) so the JSON-LD `text` stays clean.
 * Keep questions in the exact phrasing a user would type — that's what the
 * question-shaped query matching rewards.
 */
interface FaqItem {
  q: string;
  a: string;
}
interface Props {
  items: FaqItem[];
  /** Optional heading shown above the block. Set to null to omit. */
  title?: string | null;
}
const { items, title = 'Frequently asked questions' } = Astro.props;
---
{title && <h2 id="faq">{title}</h2>}

<div class="not-prose my-6 divide-y divide-border overflow-hidden rounded-xl border border-border bg-card/40">
  {items.map((item, i) => (
    <details class="group" open={i === 0}>
      <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 text-[15px] font-semibold text-foreground transition-colors hover:bg-foreground/[0.02]">
        <span>{item.q}</span>
        <span
          aria-hidden="true"
          class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-border text-muted-foreground transition-transform group-open:rotate-45"
        >
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
        </span>
      </summary>
      <div class="px-5 pb-5 text-[14.5px] leading-relaxed text-muted-foreground">{item.a}</div>
    </details>
  ))}
</div>

{/* FAQPage structured data — extractable Q&A for AI engines + search. */}
<script
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  })}
/>
