---
/**
 * Newsletter + free-course CTA shown on every docs page, directly below the
 * PageHeader (title + caption) and above the article body.
 *
 * Aesthetic intent: matches the docs SponsorCard vocabulary — `bg-card`
 * surface, hairline border, brand-green reserved for the icon badge and the
 * CTA button. A faint green-tinted gradient + dotted backdrop (borrowed from
 * the landing FinalCta) gives it just enough lift to read as a promotion
 * without shouting over the page content.
 */
import { Icon } from 'astro-icon/components';

const href = 'https://codewithmukesh.com/courses/dotnet-webapi-zero-to-hero/';
---
<aside
  class="not-prose group relative isolate my-8 overflow-hidden rounded-xl border border-border bg-gradient-to-br from-primary/[0.07] via-card to-card"
>
  {/* Dotted backdrop, fading toward the lower-right */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10"
    style="background-image: radial-gradient(circle at 1px 1px, color-mix(in oklab, var(--primary) 22%, transparent) 1px, transparent 0); background-size: 18px 18px; mask-image: radial-gradient(120% 120% at 0% 0%, black, transparent 60%); -webkit-mask-image: radial-gradient(120% 120% at 0% 0%, black, transparent 60%);"
  ></div>

  <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:gap-5">
    {/* Icon badge */}
    <div
      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary ring-1 ring-inset ring-primary/20"
      aria-hidden="true"
    >
      <Icon name="lucide:graduation-cap" class="h-[22px] w-[22px]" />
    </div>

    {/* Copy */}
    <div class="min-w-0 flex-1">
      <p class="text-[10.5px] font-semibold uppercase tracking-[0.16em] text-primary">
        Free Course &amp; Newsletter
      </p>
      <p class="mt-1 text-[15px] font-semibold leading-snug text-foreground">
        .NET Web API — Zero to Hero
      </p>
      <p class="mt-1 text-[13px] leading-relaxed text-muted-foreground">
        Join my .NET newsletter and get free, lifetime access to the complete Zero to Hero Web API course — built on .NET 10.
      </p>
    </div>

    {/* CTA */}
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-lg bg-primary px-4 py-2.5 text-[13px] font-semibold text-primary-foreground transition-colors hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background sm:py-2"
    >
      Get free access
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
    </a>
  </div>
</aside>
